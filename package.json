{
  "name": "@intermezzo-chess/chessground-react",
  "version": "1.0.0",
  "description": "A strongly-typed, idiomatic React wrapper for lichess.org's chessground chess board, with an optional chess.js integration.",
  "keywords": [
    "chess",
    "chessground",
    "chess-board",
    "react",
    "react-component",
    "lichess",
    "chess.js",
    "typescript"
  ],
  "license": "GPL-3.0-or-later",
  "author": "loding@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intermezzo-chess/chessground-react.git"
  },
  "homepage": "https://github.com/intermezzo-chess/chessground-react#readme",
  "bugs": {
    "url": "https://github.com/intermezzo-chess/chessground-react/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chess-js": {
      "types": "./dist/chess-js/index.d.ts",
      "import": "./dist/chess-js/index.js"
    },
    "./style.css": "./dist/style.css",
    "./base.css": "./dist/base.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && node scripts/build-css.mjs",
    "demo:standalone": "vite --config demo/standalone/vite.config.ts",
    "demo:nextjs": "npm --prefix demo/nextjs run dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "docs": "typedoc",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "@lichess-org/chessground": "^10.1.1",
    "chess.js": "^1.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "chess.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@changesets/get-release-plan": "^5.0.2",
    "@eslint/js": "^10.0.1",
    "@lichess-org/chessground": "^10.4.2",
    "@storybook/react-vite": "^10.5.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "chess.js": "^1.4.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@11.6.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.6.2"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
